#!/bin/bash
# Pages git-graph through less (the built-in pager was removed in git-graph 0.8.0).
# Also used by `git graph`, since git runs git-graph before checking aliases.

# Find the real git-graph: the first one on PATH that isn't this wrapper
real=$(type -ap git-graph | while read -r p; do [[ $p -ef $0 ]] || { echo "$p"; break; }; done)

# git-graph not installed: fall back to the `git graph` alias (git log --graph)
[ -n "$real" ] || exec "$(dirname "$0")/../.git_aliases/graph/script.sh" "$@"

# `model` subcommand / help / version: pass straight through
[[ $1 == model || " $* " =~ \ (-h|--help|-V|--version)\  ]] && exec "$real" "$@"

# Add defaults only if not given, since git-graph rejects repeated options
opts=()
# git-graph has no global default model (falls back to git-flow), so default to
# 'simple' unless given or set for this repo via `git-graph model <model>`
[[ " $* " =~ \ (-m|--model) || -f "$(git rev-parse --git-dir 2>/dev/null)/git-graph.toml" ]] \
    || opts+=(--model simple)
# Mirrors the `git graph` alias format (%ar works, despite missing from --help)
[[ " $* " =~ \ (-f|--format) ]] || format='%h - (%ar) %s - %an%d'

# Not a terminal (piped/redirected): skip colour/wrap/paging defaults
[ -t 1 ] || exec "$real" "${opts[@]}" ${format:+--format "$format"} "$@"

# git-graph has no %C(...), but passes raw ANSI codes through, so colour the
# format like the alias (unless colours are turned off)
[[ -n $format && ! " $* " =~ \ (--no-color|--color[\ =]never) ]] \
    && format=$'%h - \e[1;32m(%ar)\e[0m \e[37m%s\e[0m \e[2;37m- %an\e[0m%d'
[[ " $* " =~ \ --(color|no-color) ]] || opts+=(--color always)
[[ " $* " =~ \ (--wrap|-w) ]] || opts+=(--wrap=none)

# sed: recolour git-graph's hard-coded yellow (38;5;11) hash to bold blue, then
# shorten the green "(N <unit>s ago)" date to "(N<unit>)" (%ar always uses
# plural units).
# less: -R colours, -F quit if it fits on one screen, -X keep output after quit,
# -S cut long lines instead of wrapping (scroll sideways with Left/Right)
"$real" "${opts[@]}" ${format:+--format "$format"} "$@" \
    | sed -E $'
        s/\e\\[38;5;11m([0-9a-f]{7})\e\\[0m/\e[1;34m\\1\e[0m/
        s/(\e\\[1;32m\\([0-9]+) seconds ago/\\1s/
        s/(\e\\[1;32m\\([0-9]+) minutes ago/\\1m/
        s/(\e\\[1;32m\\([0-9]+) hours ago/\\1h/
        s/(\e\\[1;32m\\([0-9]+) days ago/\\1d/
        s/(\e\\[1;32m\\([0-9]+) weeks ago/\\1w/
        s/(\e\\[1;32m\\([0-9]+) months ago/\\1mo/
        s/(\e\\[1;32m\\([0-9]+) years ago/\\1y/' \
    | less -RFXS
